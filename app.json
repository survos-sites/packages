{
    "name": "packages",
    "description": "Find Symfony bundles with a powerful search tool",
    "keywords": [
        "php",
        "symfony"
    ],
    "repository": "https://github.com/survos-sites/packages",
    "scripts": {
        "dokku": {
            "predeploy": "sh -c 'bin/console mess:stop && bin/console d:m:m -n --allow-no-migration'",
            "postdeploy": "bin/console about"
        }
    },
    "addons": [
        "dokku-postgres",
        "dokku-redis",
        "dokku-rabbitmq"
    ],
    "healthchecks": {
        "web": [
            {
                "type": "startup",
                "name": "App boots and routes",
                "path": "/health",
                "attempts": 10,
                "initialDelay": 2,
                "wait": 2,
                "timeout": 5
            }
        ]
    }
}
