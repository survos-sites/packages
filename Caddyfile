{
	frankenphp
}

:{$PORT:80} {
	root * /app/public
	# No `encode` directive: packages.survos.com is Cloudflare-proxied, and
	# Cloudflare compresses on the way to the browser regardless of what the
	# origin sends. Setting Content-Encoding here just adds a layer that can
	# go wrong in transit -- confirmed live with zstd (valid at the origin,
	# broke every asset in the browser with net::ERR_CONTENT_DECODING_FAILED
	# once it hit Cloudflare's edge). Let Cloudflare own it end-to-end.

	request_body {
		max_size 64MB
	}

	# Browsers ask for /favicon.ico unprompted on the first page view of every
	# session. Without a terminating route the request falls through to php_server
	# and Symfony answers it with a NotFoundHttpException -- the single noisiest
	# line in the production log, and never a real error. `handle` blocks are
	# mutually exclusive and evaluated in the order written, so this one ends the
	# request here: public/favicon.ico is served if it exists, otherwise 204, and
	# PHP is never booted either way.
	handle /favicon.ico {
		@missing not file
		respond @missing 204
		file_server
	}

	handle {
		php_server
	}
}
