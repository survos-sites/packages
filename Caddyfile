{
	frankenphp
}

:{$PORT:80} {
	root * /app/public
	# zstd deliberately omitted: packages.survos.com is Cloudflare-proxied
	# (not a tunnel, unlike depot), and Cloudflare's edge doesn't reliably
	# pass Content-Encoding: zstd through to the browser intact -- confirmed
	# live, the origin response was valid zstd but every asset still failed
	# with net::ERR_CONTENT_DECODING_FAILED. gzip is universally solid
	# through Cloudflare.
	encode gzip

	request_body {
		max_size 64MB
	}

	php_server
}
