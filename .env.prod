# Overrides .env's http://localhost default -- needed for absolute URLs
# generated outside an HTTP request (e.g. meili:settings:update's "Index
# page:" links, generated via UrlGeneratorInterface::ABSOLUTE_URL in a
# console command with no request to infer the host from).
DEFAULT_URI=https://packages.survos.com
