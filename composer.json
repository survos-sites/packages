{
    "type": "project",
    "license": "proprietary",
    "name": "survos-sites/packages",
    "description": "Symfony application showing Symfony bundles",
    "keywords": [
        "symfony",
        "pwa",
        "datatables"
    ],
    "minimum-stability": "RC",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "ext-amqp": "*",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "ext-sockets": "*",
        "adbario/php-dot-notation": "^3.3",
        "api-platform/core": "^4.0",
        "composer/semver": "^3.4",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.4",
        "easycorp/easyadmin-bundle": "^5",
        "friendsofsymfony/jsrouting-bundle": "^3.5",
        "inspector-apm/inspector-symfony": "^1.2",
        "jwage/phpamqplib-messenger": "^0.10.1",
        "knplabs/knp-time-bundle": "^2.2",
        "knplabs/packagist-api": "^2.0|dev-master",
        "meilisearch/meilisearch-php": "dev-main",
        "nadar/cebe-php-openapi": "^1.0",
        "nadar/php-composer-reader": "^2.0",
        "nelmio/cors-bundle": "^2.4",
        "nyholm/psr7": "^1.8",
        "phpdocumentor/reflection-docblock": "^6.0",
        "sentry/sentry-symfony": "^5.0",
        "survos/api-grid-bundle": "^2.19",
        "survos/auth-bundle": "^2.18",
        "survos/command-bundle": "^2.0",
        "survos/core-bundle": "^2.0",
        "survos/crawler-bundle": "^2.0",
        "survos/elastic-bundle": "^2.24",
        "survos/ez-bundle": "^2.0",
        "survos/js-twig-bundle": "^2.0",
        "survos/lingua-core": "^2.0",
        "survos/meili-bundle": "^2.0",
        "survos/schema-org-bundle": "^2.24.12",
        "survos/search-bundle": "^2.24",
        "survos/simple-datatables-bundle": "^2.19",
        "survos/state-bundle": "^2.0",
        "survos/tabler-bundle": "^2.19",
        "symfony/amqp-messenger": "^8.0",
        "symfony/asset": "^7.0|^8.0",
        "symfony/asset-mapper": "^7.0|^8.0",
        "symfony/console": "^7.0|^8.0",
        "symfony/doctrine-messenger": "^7.0|^8.0",
        "symfony/dotenv": "^7.0|^8.0",
        "symfony/expression-language": "^7.0|^8.0",
        "symfony/flex": "^2.4",
        "symfony/form": "^7.0|^8.0",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/http-client": "^7.0|^8.0",
        "symfony/intl": "^7.0|^8.0",
        "symfony/mailer": "^7.0|^8.0",
        "symfony/mime": "^7.0|^8.0",
        "symfony/monolog-bundle": "^3.10|^4.0",
        "symfony/notifier": "^7.0|^8.0",
        "symfony/object-mapper": "^7.0|^8.0",
        "symfony/process": "^7.0|^8.0",
        "symfony/property-access": "^7.0|^8.0",
        "symfony/property-info": "^7.0|^8.0",
        "symfony/runtime": "^7.0|^8.0",
        "symfony/security-bundle": "^7.0|^8.0",
        "symfony/serializer": "^7.0|^8.0",
        "symfony/stimulus-bundle": "^3.4",
        "symfony/string": "^7.0|^8.0",
        "symfony/translation": "^7.0|^8.0",
        "symfony/twig-bundle": "^7.0|^8.0",
        "symfony/ux-chartjs": "^3.4",
        "symfony/ux-icons": "^3.4",
        "symfony/ux-turbo": "^3.4",
        "symfony/validator": "^7.0|^8.0",
        "symfony/web-link": "^7.0|^8.0",
        "symfony/yaml": "^7.0|^8.0",
        "twig/extra-bundle": "^3.8",
        "twig/twig": "^3.17",
        "zenstruck/messenger-monitor-bundle": "^0.6",
        "zenstruck/twig-service-bundle": "^1.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65",
        "nette/php-generator": "^4.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest",
        "survos/code-bundle": "^2.0|dev-main",
        "survos/supervisor-bundle": "^2.10",
        "symfony/browser-kit": "^7.0|^8.0",
        "symfony/css-selector": "^7.0|^8.0",
        "symfony/debug-bundle": "^7.0|^8.0",
        "symfony/maker-bundle": "^1.57",
        "symfony/phpunit-bridge": "^7.0|^8.0",
        "symfony/stopwatch": "^7.0|^8.0",
        "symfony/web-profiler-bundle": "^7.0|^8.0"
    },
    "config": {
        "allow-plugins": {
            "endroid/installer": false,
            "php-http/discovery": true,
            "survos/installer": false,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^8.0"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:warmup": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "php -d memory_limit=512M bin/console cache:clear",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "php -d memory_limit=512M bin/console cache:clear",
            "@auto-scripts"
        ],
        "setup": [
            "php -d memory_limit=4048M bin/console app:load-data"
        ],
        "load": [
            "php -d memory_limit=4048M bin/console workflow:iterate App\\\\Entity\\\\Package --marking=new --transition=load"
        ],
        "index": [
            "php -d memory_limit=2048M bin/console meili:index --reset"
        ],
        "coverage": "php -d xpcov.enabled=1 vendor/bin/phpunit --coverage-html coverage"
    }
}
