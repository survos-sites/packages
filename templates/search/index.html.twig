{% extends 'base.html.twig' %}
{% block title %}Symfony bundles{% endblock %}
{% block page_title %}Search{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('styles/search.css') }}">{% endblock %}
{% block page_content %}
{% set sc = survos_stimulus('search-bundle', 'instantsearch') %}
<div class="pk-shell" {{ stimulus_controller(sc, {endpoint: path('survos_search_instant'), name: name, template: path('app_search_template'), sorts: sorts}) }}>
    <header class="pk-heading">
        <div>
            <h1>Symfony bundles</h1>
            <p>Bundles harvested from Packagist, filterable by the Symfony and PHP versions they support.</p>
        </div>
    </header>
    <div class="pk-searchbox" {{ stimulus_target(sc, 'query') }}></div>
    <div class="pk-error" hidden role="alert" {{ stimulus_target(sc, 'error') }}></div>
    <div class="pk-workspace">
        <aside class="pk-sidebar" aria-label="Search filters">
            <div class="pk-filter-heading"><h2>Refine results</h2><div {{ stimulus_target(sc, 'clear') }}></div></div>
            {% for field, label in facets %}<section class="pk-facet"><h3>{{ label }}</h3><div data-field="{{ field }}" data-label="{{ label }}" {{ stimulus_target(sc, 'facet') }}></div></section>{% endfor %}
        </aside>
        <main class="pk-results">
            <div class="pk-toolbar"><div aria-live="polite" {{ stimulus_target(sc, 'stats') }}></div><div aria-label="Sort results" {{ stimulus_target(sc, 'sort') }}></div></div>
            <div class="pk-current" {{ stimulus_target(sc, 'current') }}></div>
            <div {{ stimulus_target(sc, 'hits') }}></div>
            <div class="pk-pagination" {{ stimulus_target(sc, 'pagination') }}></div>
        </main>
    </div>
</div>
{% endblock %}
