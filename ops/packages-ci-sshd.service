[Unit]
Description=Packages GitHub Actions restricted SSH endpoint
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -m 0755 /run/sshd
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/sshd_config_packages_ci
ExecStart=/usr/sbin/sshd -D -e -f /etc/ssh/sshd_config_packages_ci
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
